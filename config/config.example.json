  "bash_policy": {
    "enabled": true,
    "_comment": "Bash command policy: deny_commands/deny_paths are checked before any shell spawn. The model can request a wider permission with sandbox_permissions=danger-full-access plus justification; the host approval layer decides whether to grant it and the result records the request. allow_commands, when non-empty, becomes a strict whitelist; leave empty to permit any non-denied command. strict_deny_only=true skips the default deny list and uses only what you set here.",
    "deny_commands": [
      "format",
      "format-volume",
      "clear-disk",
      "initialize-disk",
      "diskpart",
      "fdisk",
      "mkfs",
      "dd",
      "sudo",
      "su",
      "runas",
      "shutdown",
      "stop-computer",
      "reboot",
      "restart-computer",
      "halt",
      "poweroff",
      "init",
      "netsh",
      "iptables"
    ],
    "deny_paths": [
      "C:\\Windows",
      "C:\\Windows\\System32",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "/etc",
      "/boot",
      "/usr/bin",
      "/usr/sbin",
      "/sbin"
    ]
  },
  "segmented_memory": {
    "enabled": true,
