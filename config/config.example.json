      "_comment": "web_fetch 的生产摘要模型兼容字段；本地 web_fetch 直接抓取正文并支持 file_mode=stateless 二进制下载，仅在切换到 HTTP backend 时需要。",
      "summaryModelName": "MaaS_Cl_Sonnet_46_Multi_Modal",
      "summaryModelBaseUrl": "https://clotho-test.xiaohuanxiong.com/v2/llm"
    },
    "webBudget": {
      "_comment": "Codex 风格动态 web 输出预算：按当前 prompt 占用、输出预留和 summary 阈值计算剩余空间，再把本轮预算分给并行 web_search/web_fetch。不是额外摘要模型。",
      "enabled": true,
      "contextWindowTokens": 128000,
      "outputReserveTokens": 16384,
      "safetyReserveTokens": 8000,
      "minTurnTokens": 2000,
      "maxTurnTokens": 32000,
      "turnSharePercent": 50,
      "searchMaxResults": 8,
      "searchSnippetChars": 600,
      "fetchMaxChars": 24000
    },
    "readFile": {
