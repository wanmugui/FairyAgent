{
  "name": "fairy-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.cjs",
    "pwa": "vite build && npx serve dist",
    "test:summary": "node tests/summary-normalize.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test src/utils/*.test.js src/utils/*.test.mjs src/features/chat/*.test.mjs",
    "verify": "pnpm run typecheck && pnpm run test:unit && pnpm run build",
    "test:integration": "node --loader ./tests/esm-extensionless-loader.mjs --test tests/*.test.mjs",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.18.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
